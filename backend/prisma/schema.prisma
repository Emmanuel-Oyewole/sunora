generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "conversations", "generation"]
}

// identity
enum Role {
  USER
  ADMIN

  @@schema("identity")
}

enum SessionRevokedReason {
  LOGOUT
  LOGOUT_ALL
  REUSE_DETECTED // a rotated refresh token was replayed outside the grace window
  PASSWORD_RESET
  PASSWORD_CHANGED
  ADMIN

  @@schema("identity")
}

enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@schema("identity")
}

enum AuthEventType {
  REGISTER
  REGISTRATION_EXISTING_EMAIL // someone tried to register an email that already has an account
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESH
  REFRESH_REUSE_DETECTED
  SESSION_REVOKED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED

  @@schema("identity")
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique // stored lowercase; a lower(email) unique index backs this up in SQL
  passwordHash      String    @map("password_hash") // argon2id
  name              String
  role              Role      @default(USER)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   Session[]
  userTokens UserToken[]
  authEvents AuthEvent[]

  @@map("users")
  @@schema("identity")
}

// One row per login (one browser or device). Access JWTs carry its id as the
// `sid` claim. The session is checked when a refresh token is used, not on
// every request, so an issued access token stays valid until it expires.
model Session {
  id            String                @id @default(uuid(7)) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime              @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(3) // absolute lifetime cap; refresh cannot extend past it
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(3)
  revokedReason SessionRevokedReason? @map("revoked_reason")
  userAgent     String?               @map("user_agent")
  ip            String?               @db.Inet

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  // Partial in SQL: WHERE revoked_at IS NULL. Lists and revokes a user's active sessions.
  @@index([userId], map: "sessions_active_user_idx")
  @@index([expiresAt])
  @@map("sessions")
  @@schema("identity")
}

// Rotating refresh tokens. Each use creates a child (parentId = the token that
// was presented). A parent can have more than one child because a replay inside
// the grace window (two tabs refreshing at once) is tolerated; a replay outside
// it revokes the session.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") // SHA-256 of the raw token; the raw token is never stored
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3) // sliding, never later than the session's expiresAt
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3) // set when rotated
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session  Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("RefreshTokenLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children RefreshToken[] @relation("RefreshTokenLineage")

  @@index([sessionId])
  @@index([parentId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("identity")
}

// One-time tokens emailed to the user (verify address, reset password).
// Only the SHA-256 hash is stored.
model UserToken {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  purpose     UserTokenPurpose
  tokenHash   String           @unique @map("token_hash")
  email       String // address the token was issued for; a verification link is only valid while it still equals users.email
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?        @map("used_at") @db.Timestamptz(3)
  revokedAt   DateTime?        @map("revoked_at") @db.Timestamptz(3) // superseded by a newer token of the same purpose
  requestedIp String?          @map("requested_ip") @db.Inet
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial unique in SQL: WHERE used_at IS NULL AND revoked_at IS NULL, so a
  // user has at most ONE active token per purpose. Declared unique here only so
  // Prisma sees the same index; never use it as a lookup key.
  @@unique([userId, purpose], map: "user_tokens_one_active_key")
  // Serves the resend cooldown: latest token per user and purpose.
  @@index([userId, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("user_tokens")
  @@schema("identity")
}

// Append-only security audit log. Never store tokens or passwords in metadata.
model AuthEvent {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String?       @map("user_id") @db.Uuid // null for failed logins on unknown emails
  sessionId String?       @map("session_id") @db.Uuid // plain id, no FK: audit rows must outlive purged sessions
  type      AuthEventType
  ip        String?       @db.Inet
  userAgent String?       @map("user_agent")
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
  @@schema("identity")
}

// conversations
enum TitleSource {
  DEFAULT
  GENERATED
  MANUAL

  @@schema("conversations")
}

enum MessageRole {
  USER
  ASSISTANT

  @@schema("conversations")
}

// What the user sees as chat history. A conversation is created by its first message.
model Conversation {
  id            String      @id @default(uuid(7)) @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid // logical ref to identity.users, no FK across schemas
  title         String?
  titleSource   TitleSource @default(DEFAULT) @map("title_source")
  activeLeafId  String?     @map("active_leaf_id") @db.Uuid // the last message of the branch being shown
  lastMessageAt DateTime    @default(now()) @map("last_message_at") @db.Timestamptz(3)
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  messages   Message[]
  activeLeaf Message?  @relation("ActiveLeaf", fields: [activeLeafId], references: [id], onDelete: SetNull)

  // Partial in SQL: WHERE deleted_at IS NULL. Serves the history list (keyset pagination).
  @@index([ownerId, lastMessageAt(sort: Desc), id(sort: Desc)], map: "conversations_history_idx")
  @@map("conversations")
  @@schema("conversations")
}

// A node in the conversation tree. Immutable: written once, complete. Partial or
// failed answers never live here. Editing a prompt or regenerating adds a sibling.
model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  parentId       String?     @map("parent_id") @db.Uuid // null for a root; there can be several roots
  role           MessageRole
  content        String
  reasoning      String? // assistant only: the model's reasoning, shown collapsed
  depth          Int // root = 0, derived from the parent when inserting
  generationId   String?     @map("generation_id") @db.Uuid // logical ref, assistant only
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // The parent must be in the same conversation, so a crafted request cannot graft trees together.
  parent       Message?       @relation("MessageTree", fields: [conversationId, parentId], references: [conversationId, id], onDelete: NoAction, onUpdate: NoAction)
  children     Message[]      @relation("MessageTree")
  leafOf       Conversation[] @relation("ActiveLeaf")

  @@unique([conversationId, id])
  @@index([conversationId, parentId])
  @@map("messages")
  @@schema("conversations")
}

// generation
enum GenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED

  @@schema("generation")
}

enum GenerationTrigger {
  INITIAL
  RETRY
  REGENERATE

  @@schema("generation")
}

enum ChunkKind {
  TEXT
  REASONING

  @@schema("generation")
}

// One row per attempt to produce an answer. A retry or regenerate adds a row for
// the same user message; nothing is ever overwritten. The ids of other modules'
// rows are logical references (no foreign keys across schemas).
model Generation {
  id                 String            @id @default(uuid(7)) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  conversationId     String            @map("conversation_id") @db.Uuid
  userMessageId      String            @map("user_message_id") @db.Uuid // the prompt being answered
  assistantMessageId String?           @map("assistant_message_id") @db.Uuid // set when the answer is saved
  attemptNumber      Int               @map("attempt_number")
  trigger            GenerationTrigger
  status             GenerationStatus  @default(PENDING)
  thinking           Boolean           @default(false)
  provider           String
  model              String
  finishReason       String?           @map("finish_reason")
  ownerInstanceId    String?           @map("owner_instance_id") // the process running it, for restart detection
  heartbeatAt        DateTime?         @map("heartbeat_at") @db.Timestamptz(3)
  cancelRequestedAt  DateTime?         @map("cancel_requested_at") @db.Timestamptz(3)
  errorCode          String?           @map("error_code") // a stable code, never provider text
  startedAt          DateTime?         @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?         @map("finished_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  chunks          GenerationChunk[]
  idempotencyKeys IdempotencyKey[]

  @@unique([userMessageId, attemptNumber])
  @@index([userId, conversationId, createdAt(sort: Desc)])
  // Partial in SQL: WHERE status IN ('PENDING', 'RUNNING'). Serves the restart sweep.
  @@index([status, heartbeatAt], map: "generations_active_sweep_idx")
  // Partial in SQL: WHERE status IN ('PENDING', 'RUNNING'). Counts a user's active generations.
  @@index([userId], map: "generations_active_user_idx")
  @@map("generations")
  @@schema("generation")
}

// The recovery log: a fragment of an answer that is being produced. `seq` is also
// the SSE event id, so a reconnecting browser asks for everything after the last one it saw.
model GenerationChunk {
  generationId String    @map("generation_id") @db.Uuid
  seq          Int
  kind         ChunkKind @default(TEXT)
  text         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@id([generationId, seq])
  @@map("generation_chunks")
  @@schema("generation")
}

// Makes a submit safe to repeat: the same key and body gives the same result.
model IdempotencyKey {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  conversationId String?  @map("conversation_id") @db.Uuid // with messageId, lets a retry finish a submit that stopped half way
  messageId      String?  @map("message_id") @db.Uuid
  generationId   String?  @map("generation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3) // also reset when a stale claim is taken over
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@unique([userId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("generation")
}
