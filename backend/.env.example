# Copy to .env and fill in. Never commit .env.

PORT=3001
NODE_ENV=development

# Database (DB_HOST is the docker-compose service name when running in Docker)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_HOST=localhost
DB_PORT=5432

# Auth: HS256 signing secret, at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# Optional tuning (seconds); defaults shown
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600
# SESSION_MAX_AGE_SECONDS=2592000
# REFRESH_GRACE_SECONDS=10
# EMAIL_VERIFICATION_TTL_SECONDS=86400
# PASSWORD_RESET_TTL_SECONDS=1800
# RESEND_COOLDOWN_SECONDS=60

# Web app origin (CORS, CSRF origin check, links in emails)
WEB_URL=http://localhost:3000

# Email: "console" logs emails locally (not allowed in production); "brevo" sends them
EMAIL_PROVIDER=console
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Sunora

# AI provider (DeepSeek)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# Generation tuning; defaults shown
# GENERATION_MAX_OUTPUT_TOKENS=4096
# GENERATION_MAX_OUTPUT_TOKENS_THINKING=16384
# GENERATION_CONTEXT_CHAR_BUDGET=60000

# Third-party telemetry (optional)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# Database tests (npm run test:db). Put this in .env.test.local, which git ignores.
# Create the database once: docker compose exec db psql -U <POSTGRES_USER> -d postgres -c "CREATE DATABASE sunora_test"
# Then migrate it: DATABASE_URL=<this url> npx prisma migrate deploy
# The database name must end in "_test": the tests empty its tables.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sunora_test
