# Copy to .env and fill in. Never commit .env.

PORT=3001
NODE_ENV=development

# Database (DB_HOST is the docker-compose service name when running in Docker)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DB_HOST=localhost
DB_PORT=5432

# Auth: HS256 signing secret, at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# Optional tuning (seconds); defaults shown
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600
# SESSION_MAX_AGE_SECONDS=2592000
# REFRESH_GRACE_SECONDS=10
# EMAIL_VERIFICATION_TTL_SECONDS=86400
# PASSWORD_RESET_TTL_SECONDS=1800
# RESEND_COOLDOWN_SECONDS=60

# Web app origin (CORS, CSRF origin check, links in emails)
WEB_URL=http://localhost:3000

# Email: "console" logs emails locally (not allowed in production); "brevo" sends them
EMAIL_PROVIDER=console
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=Sunora

# Third-party telemetry (optional)
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
